<?xml version="1.0" encoding="utf-8"?>
<!-- v0.4.0 App 卡片：22dp 圆角 + 1dp 发丝描边。
     不用 MaterialCardView —— 这个 App 没引 Material 依赖（见 README §12.1），
     卡片的全部需求就是「圆角 + 描边 + 纯色面」，shape 就够，且不会把主题绑到 Material3。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_card" />
    <stroke android:width="1dp" android:color="@color/card_stroke" />
    <corners android:radius="22dp" />
</shape>
