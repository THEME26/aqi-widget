<?xml version="1.0" encoding="utf-8"?>
<!-- v0.1.9 小部件玻璃底：半透明，让桌面壁纸透出来（对齐系统自带小部件的通透感）。
     sheen 只取顶部 10%，形成一条几乎看不见的高光边，避免「纯色大板砖」。
     所有颜色走语义引用，values / values-night 自动切换。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_base" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerY="0.10"
                android:endColor="@color/glass_sheen_bottom"
                android:startColor="@color/glass_sheen_top"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/glass_hair" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
