<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_refresh"
        android:shortcutId="refresh"
        android:shortcutLongLabel="@string/shortcut_refresh_long"
        android:shortcutShortLabel="@string/shortcut_refresh_short">
        <intent
            android:action="io.github.theme26.aqibar.action.REFRESH"
            android:targetClass="io.github.theme26.aqibar.ui.MainActivity" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_tab_settings"
        android:shortcutId="settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:shortcutShortLabel="@string/shortcut_settings_short">
        <intent
            android:action="io.github.theme26.aqibar.action.SETTINGS"
            android:targetClass="io.github.theme26.aqibar.ui.MainActivity" />
    </shortcut>

</shortcuts>
