<?xml version="1.0" encoding="utf-8"?>
<!-- v0.4.0 三屏骨架：内容区 + 底部三 tab。
     三页全部常驻 inflate（不销毁重创建），因为设置页有 EditText 与滚动位置，
     来回切 tab 时如果重建会丢焦点与滚动。三页合计不到 200 个 View，内存可接受。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/page_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page_today"
            layout="@layout/page_today" />

        <include
            android:id="@+id/page_detail"
            layout="@layout/page_detail"
            android:visibility="gone" />

        <include
            android:id="@+id/page_settings"
            layout="@layout/page_settings"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tabbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tabbar"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:id="@+id/tab_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/tab_today_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_today"
                android:src="@drawable/ic_tab_today"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tab_today_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_today"
                android:textColor="@color/text_primary"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/tab_detail_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_detail"
                android:src="@drawable/ic_tab_detail"
                app:tint="@color/text_dim" />

            <TextView
                android:id="@+id/tab_detail_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_detail"
                android:textColor="@color/text_dim"
                android:textSize="9.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/tab_settings_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_settings"
                android:src="@drawable/ic_tab_settings"
                app:tint="@color/text_dim" />

            <TextView
                android:id="@+id/tab_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_settings"
                android:textColor="@color/text_dim"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
