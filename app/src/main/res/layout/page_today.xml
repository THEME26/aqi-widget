<?xml version="1.0" encoding="utf-8"?>
<!-- 屏 1「今日」：只回答一件事 —— 现在能不能出门。
     结构：位置 + 刷新 → 主卡（环 / 结论 / 两条对比）→ 9 格分布 → 污染物分指数。
     口径说明、诊断文字、免责声明一律不在这一屏，它们属于「详情」。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <!-- 位置行：左侧「站点名 / 距离」，右侧一个圆形刷新钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nav_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:letterSpacing="-0.02"
                    android:text="@string/getting"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/text_dim" />

                    <TextView
                        android:id="@+id/nav_sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/getting"
                        android:textColor="@color/text_dim"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/btn_refresh_now"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/text_secondary" />
            </FrameLayout>
        </LinearLayout>

        <!-- 状态条：只在出错 / 正在获取时出现。默认 GONE，避免长期占位 -->
        <TextView
            android:id="@+id/aqi_sync_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_app_card"
            android:lineSpacingExtra="2dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/aqi_usg_ink"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Hero：双层渐变底（顶端区域档色 → 底端本站档色），与桌面 4×2 同一套 BgPainter -->
        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero_app"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/hero_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 环 + 环内读数：数字必须在环里，否则「环是量程」这件事就没人看得懂 -->
                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp">

                        <ImageView
                            android:id="@+id/hero_gauge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/hero_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.045"
                                android:text="@string/dash"
                                android:textColor="@color/text_primary"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hero_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.06"
                                android:text="@string/unit_aqi"
                                android:textColor="@color/text_dim"
                                android:textSize="8sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/hero_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.02"
                            android:text="@string/getting"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_advice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 两条对比：区域（对照）/ 本站（主读数） -->
                <LinearLayout
                    android:id="@+id/hero_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lbl_area"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/widget_area"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.example.aqi.ui.ValueBarView
                            android:id="@+id/bar_area"
                            android:layout_width="0dp"
                            android:layout_height="7dp"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/val_area"
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/label_site"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.example.aqi.ui.ValueBarView
                            android:id="@+id/bar_site"
                            android:layout_width="0dp"
                            android:layout_height="7dp"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/val_site"
                            android:layout_width="38dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/hero_diff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_dim"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 9 格分布：只在区域数据可用时显示 -->
        <LinearLayout
            android:id="@+id/grid_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/grid_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/grid_median"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dim"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- 这行同时解决两件事：说明圆点可以点，以及把「模式场时间」摆出来 ——
                 用户看到数值几小时不动时，至少能判断是模式场没更新还是 App 没刷新。 -->
            <TextView
                android:id="@+id/grid_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_dim"
                android:textSize="10.5sp" />

            <!-- v0.4.6：站点环取不到、退回模式格点时在这里写明原因。
                 没有这一行，卡片上写着「9 个格点」，用户会以为站点环生效了；
                 有了它，用户截一张图就能说清是哪一步坏了（HTTP 429 / Invalid key…）。 -->
            <TextView
                android:id="@+id/grid_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_dim"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <!-- 周边九宫格（v0.4.5）：位置 = 地理方位，正中 = 你 / 最近站点。
                 为什么从圆环退回方格：圆点只有 15dp，三位数根本放不进点里；
                 方格能塞下 "203" 且点击热区大，用户点哪一格就是哪一格。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.example.aqi.ui.AreaGridView
                    android:id="@+id/area_grid"
                    android:layout_width="176dp"
                    android:layout_height="176dp" />

                <!-- 图例：最低 / 中位 / 最高。三个数始终都出现，
                     这样「取最差格点」开关只是换主数字，不会让另外两个数消失。 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stat_max_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/area_max"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/stat_max_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stat_med_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/area_median"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/stat_med_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stat_min_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/area_min"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/stat_min_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 污染物分指数 -->
        <LinearLayout
            android:id="@+id/poll_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/poll_title"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/poll_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dim"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/poll_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 页脚：数据来源与更新时间。顺便把「往下还有详情」这件事说出来，
             否则用户不知道点了数之后还能去哪里看依据。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/foot_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_dim"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/foot_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/foot_detail_link"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
