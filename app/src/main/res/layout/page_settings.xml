<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:text="@string/tab_settings"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_dim"
            android:textSize="11.5sp" />

        <TextView
            style="@style/AqiGroupHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/group_data" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/AqiRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_source" />

            <TextView
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/row_source_desc" />

            <io.github.theme26.aqibar.ui.SegmentedControl
                android:id="@+id/seg_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <View
                style="@style/AqiDivider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                style="@style/AqiRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_standard" />

            <io.github.theme26.aqibar.ui.SegmentedControl
                android:id="@+id/seg_standard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/standard_desc"
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/standard_short_us" />

            <View
                style="@style/AqiDivider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AqiRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/row_dual" />

                    <TextView
                        style="@style/AqiRowDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/row_dual_desc" />
                </LinearLayout>

                <io.github.theme26.aqibar.ui.ToggleSwitch
                    android:id="@+id/sw_dual_source"
                    android:layout_width="44dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:checked="true" />
            </LinearLayout>

            <View
                style="@style/AqiDivider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AqiRowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/switch_area" />

                <io.github.theme26.aqibar.ui.ToggleSwitch
                    android:id="@+id/sw_area"
                    android:layout_width="44dp"
                    android:layout_height="26dp"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/switch_area_desc" />

            <LinearLayout
                android:id="@+id/area_radius_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/AqiRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/row_area_source" />

                <TextView
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/row_area_source_desc" />

                <io.github.theme26.aqibar.ui.SegmentedControl
                    android:id="@+id/seg_area_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:id="@+id/radius_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AqiRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/row_radius" />

                    <TextView
                        style="@style/AqiRowDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/row_radius_desc" />

                    <io.github.theme26.aqibar.ui.SegmentedControl
                        android:id="@+id/seg_radius"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/radius_rank_note"
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/row_radius_rank_note"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AqiRowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/row_area_worst" />

                    <io.github.theme26.aqibar.ui.ToggleSwitch
                        android:id="@+id/sw_area_worst"
                        android:layout_width="44dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:checked="false" />
                </LinearLayout>

                <TextView
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/row_area_worst_desc" />
            </LinearLayout>

            <View
                style="@style/AqiDivider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                style="@style/AqiRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_interval" />

            <io.github.theme26.aqibar.ui.SegmentedControl
                android:id="@+id/seg_interval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/token_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/AqiRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/token_label" />

            <EditText
                android:id="@+id/token_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:background="@drawable/bg_seg_track"
                android:hint="@string/token_hint"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_seg_thumb"
                android:text="@string/action_save"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/AqiGroupHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/group_alert" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/AqiRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_policy" />

            <TextView
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/row_policy_desc" />

            <io.github.theme26.aqibar.ui.SegmentedControl
                android:id="@+id/seg_policy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/hint_notif_denied"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_seg_track"
                android:padding="10dp"
                android:text="@string/hint_notif_denied"
                android:textColor="@color/aqi_usg_ink"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <View
                style="@style/AqiDivider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AqiRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/row_lock" />

                    <TextView
                        style="@style/AqiRowDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/row_lock_desc" />
                </LinearLayout>

                <io.github.theme26.aqibar.ui.ToggleSwitch
                    android:id="@+id/sw_lock_full"
                    android:layout_width="44dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AqiRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/row_live" />

                    <TextView
                        android:id="@+id/tv_live_state"
                        style="@style/AqiRowDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/live_state_unknown" />
                </LinearLayout>

                <io.github.theme26.aqibar.ui.ToggleSwitch
                    android:id="@+id/sw_live"
                    android:layout_width="44dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/AqiGroupHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/group_location" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/AqiRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_coord" />

            <TextView
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/row_coord_desc" />

            <EditText
                android:id="@+id/coord_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_seg_track"
                android:hint="@string/coord_hint"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_save_coord"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_seg_thumb"
                android:text="@string/btn_save_coord"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/AqiGroupHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/group_widget" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_pin_main"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg_track"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="26dp">

                        <View
                            android:layout_width="46dp"
                            android:layout_height="19dp"
                            android:layout_gravity="center"
                            android:alpha="0.35"
                            android:background="@drawable/bg_size_chip" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/size_4x2"
                        android:textColor="@color/text_dim"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_pin_compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg_track"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="26dp">

                        <View
                            android:layout_width="26dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:alpha="0.35"
                            android:background="@drawable/bg_size_chip" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/size_2x1"
                        android:textColor="@color/text_dim"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_pin_tall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg_track"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="26dp">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:alpha="0.35"
                            android:background="@drawable/bg_size_chip" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/size_1x2"
                        android:textColor="@color/text_dim"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_pin_square"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg_track"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="26dp">

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:alpha="0.35"
                            android:background="@drawable/bg_size_chip" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/size_1x1"
                        android:textColor="@color/text_dim"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_diag"
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_secondary" />

            <TextView
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/widget_add_hint" />
        </LinearLayout>

        <TextView
            style="@style/AqiGroupHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/group_perm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/btn_location_perm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AqiRowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/perm_location" />

                <TextView
                    android:id="@+id/val_location_perm"
                    style="@style/AqiRowValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/text_dim" />
            </LinearLayout>

            <View style="@style/AqiDivider" />

            <LinearLayout
                android:id="@+id/btn_notif_perm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AqiRowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/perm_notif" />

                <TextView
                    android:id="@+id/val_notif_perm"
                    style="@style/AqiRowValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/text_dim" />
            </LinearLayout>

            <View style="@style/AqiDivider" />

            <LinearLayout
                android:id="@+id/btn_battery"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AqiRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_battery" />

                    <TextView
                        style="@style/AqiRowDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_battery_desc" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/text_dim" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/AqiGroupHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/group_about" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/explain_toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AqiRowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/explain_toggle_more" />

                <ImageView
                    android:id="@+id/explain_chevron"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/text_dim" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/explain_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dual_hint" />

                <TextView
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mask_disclaimer" />

                <TextView
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/source_diff_hint" />

                <TextView
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/hint_lock_dep" />

                <TextView
                    android:id="@+id/about_standard"
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/standard_desc_us" />

                <TextView
                    style="@style/AqiRowDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/disclaimer" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_version"
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/AqiRowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/attribution" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
